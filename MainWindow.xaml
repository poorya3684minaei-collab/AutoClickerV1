<Window x:Class="AutoClickerV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Clicker V1"
        Width="1080"
        Height="650"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="＋ افزودن نقطه"
                        Width="135"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="AddPoint_Click"/>
                <Button Content="✎ ویرایش رنگ"
                        Width="125"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="EditColor_Click"/>
                <Button Content="حذف نقطه"
                        Width="105"
                        Height="38"
                        Click="DeletePoint_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▶ شروع"
                        Width="100"
                        Height="38"
                        Margin="8,0,8,0"
                        Click="Start_Click"
                        Background="#2E8B57"
                        Foreground="White"/>
                <Button Content="■ توقف"
                        Width="100"
                        Height="38"
                        Click="Stop_Click"
                        Background="#B22222"
                        Foreground="White"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#F1F1F1" Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="X" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="تاخیر" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="بررسی رنگ" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="رنگ ذخیره‌شده" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </Grid>

                    <ListView x:Name="PointsList"
                              Grid.Row="1"
                              Margin="0,6,0,0"
                              SelectionChanged="PointsList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="60"
                                                DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="X" Width="100"
                                                DisplayMemberBinding="{Binding X}"/>
                                <GridViewColumn Header="Y" Width="100"
                                                DisplayMemberBinding="{Binding Y}"/>
                                <GridViewColumn Header="تاخیر" Width="110"
                                                DisplayMemberBinding="{Binding DelayText}"/>
                                <GridViewColumn Header="بررسی رنگ" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CheckMode}"
                                                      IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رنگ" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#555"
                                                        BorderThickness="1"
                                                        Margin="2,0,8,0"/>
                                                <TextBlock Text="{Binding ColorHex}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="تنظیمات اجرا"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="تعداد تکرار" Margin="0,0,0,5"/>
                    <TextBox x:Name="RepeatCountBox"
                             Text="1"
                             Height="34"
                             Padding="8"
                             Margin="0,0,0,12"/>

                    <CheckBox x:Name="InfiniteCheckBox"
                              Content="تکرار نامحدود"
                              Margin="0,0,0,18"
                              Checked="Infinite_Checked"
                              Unchecked="Infinite_Unchecked"/>

                    <TextBlock Text="تاخیر نقطه انتخاب‌شده (ثانیه)"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="DelayBox"
                             Text="1.0"
                             Height="34"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <Button Content="اعمال تاخیر"
                            Height="34"
                            Margin="0,0,0,18"
                            Click="ApplyDelay_Click"/>

                    <TextBlock Text="رنگ نقطه انتخاب‌شده"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="ColorInfoText"
                               Text="—"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="تحمل اختلاف رنگ"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="ToleranceBox"
                             Text="10"
                             Height="34"
                             Padding="8"
                             Margin="0,0,0,14"/>

                    <Button Content="فعال کردن بررسی رنگ برای این نقطه"
                            Height="42"
                            Click="EnableColorCheck_Click"/>

                    <Button Content="غیرفعال کردن بررسی رنگ"
                            Height="38"
                            Margin="0,8,0,0"
                            Click="DisableColorCheck_Click"/>

                    <Separator Margin="0,18,0,12"/>

                    <TextBlock x:Name="StatusText"
                               Text="آماده"
                               TextWrapping="Wrap"
                               Foreground="#444444"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="10"
                Background="#F7F7F7"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="نکته: وقتی بررسی رنگ فعال باشد، اگر رنگ آن نقطه با رنگ ذخیره‌شده در محدوده تحمل نباشد، آن کلیک انجام نمی‌شود."
                       Foreground="#444444"/>
        </Border>
    </Grid>
</Window>
