<Window x:Class="AutoClickerV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Clicker V1"
        Width="900"
        Height="650"
        MinWidth="750"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="Padding"
                    Value="18,10"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="SmallButtonStyle"
               TargetType="Button">
            <Setter Property="Margin"
                    Value="3"/>
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin"
                    Value="8"/>
            <Setter Property="Padding"
                    Value="8"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان -->
        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,10">

            <StackPanel>
                <TextBlock Text="Auto Clicker V1"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="کلیک خودکار چندنقطه‌ای برای Windows"
                           Foreground="#D1D5DB"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

        </Border>


        <!-- محتوای اصلی -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>


            <!-- لیست نقاط -->
            <GroupBox Grid.Column="0"
                      Header="نقاط کلیک">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- دکمه های نقاط -->
                    <WrapPanel Grid.Row="0"
                               Margin="0,0,0,8">

                        <Button Content="＋ افزودن نقطه"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddPoint_Click"/>

                        <Button Content="حذف نقطه"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="DeletePoint_Click"/>

                        <Button Content="به‌روزرسانی رنگ"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="EditColor_Click"/>

                    </WrapPanel>


                    <!-- لیست -->
                    <ListBox x:Name="PointsList"
                             Grid.Row="1"
                             SelectionChanged="PointsList_SelectionChanged"
                             BorderThickness="1"
                             Padding="5">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#D1D5DB"
                                        BorderThickness="0,0,0,1"
                                        Padding="8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Number, StringFormat=№ {0}}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="مختصات: "/>
                                                <Run Text="{Binding X}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding Y}"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding ColorHex}"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DelayText}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CheckMode}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <!-- راهنما -->
                    <TextBlock Grid.Row="2"
                               Text="برای افزودن نقطه، ابتدا روی «افزودن نقطه» بزنید و سپس محل موردنظر را روی صفحه انتخاب کنید."
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Margin="5,10,5,3"/>

                </Grid>

            </GroupBox>


            <!-- پنل تنظیمات -->
            <GroupBox Grid.Column="1"
                      Header="تنظیمات نقطه">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="اطلاعات نقطه"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="5,5,5,12"/>


                        <TextBlock Text="رنگ ذخیره‌شده:"
                                   FontWeight="SemiBold"
                                   Margin="5,3"/>

                        <Border Background="#E5E7EB"
                                CornerRadius="5"
                                Padding="10"
                                Margin="4">

                            <TextBlock x:Name="ColorInfoText"
                                       Text="—"
                                       FontFamily="Consolas"
                                       FontSize="14"/>

                        </Border>


                        <TextBlock Text="فاصله / تأخیر (ثانیه)"
                                   FontWeight="SemiBold"
                                   Margin="5,15,5,3"/>

                        <TextBox x:Name="DelayBox"
                                 Text="1.0"/>

                        <Button Content="اعمال تأخیر"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="ApplyDelay_Click"/>


                        <Separator Margin="5,15"/>


                        <TextBlock Text="بررسی رنگ"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="5,5,5,10"/>

                        <TextBlock Text="Tolerance"
                                   FontWeight="SemiBold"
                                   Margin="5,3"/>

                        <TextBox x:Name="ToleranceBox"
                                 Text="10"/>

                        <Button Content="فعال کردن بررسی رنگ"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="EnableColorCheck_Click"/>

                        <Button Content="غیرفعال کردن بررسی رنگ"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="DisableColorCheck_Click"/>


                        <Separator Margin="5,15"/>


                        <TextBlock Text="تعداد تکرار"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="5,5,5,10"/>

                        <TextBox x:Name="RepeatCountBox"
                                 Text="1"/>

                        <CheckBox x:Name="InfiniteCheckBox"
                                  Content="تکرار نامحدود"
                                  Margin="5,8"
                                  Checked="Infinite_Checked"
                                  Unchecked="Infinite_Unchecked"/>


                        <Separator Margin="5,15"/>


                        <Button Content="▶  شروع"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="10"
                                Margin="4"
                                Click="Start_Click"/>

                        <Button Content="■  توقف"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="10"
                                Margin="4"
                                Click="Stop_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </GroupBox>

        </Grid>


        <!-- وضعیت -->
        <Border Grid.Row="2"
                Background="#E5E7EB"
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,0">

            <TextBlock x:Name="StatusText"
                       Text="آماده"
                       FontSize="13"
                       TextWrapping="Wrap"/>

        </Border>

    </Grid>

</Window>
