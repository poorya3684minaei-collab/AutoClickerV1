<Window x:Class="AutoClickerV1.PointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب نقطه"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Border Background="#CC000000"
                CornerRadius="8"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,35,0,0">

            <StackPanel>
                <TextBlock Text="انتخاب نقطه"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="روی محل موردنظر کلیک کنید"
                           Foreground="White"
                           FontSize="17"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Esc برای لغو"
                           Foreground="#DDDDDD"
                           FontSize="14"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

        </Border>
    </Grid>
</Window>
