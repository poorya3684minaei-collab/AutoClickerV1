<Window x:Class="AutoClickerV1.PointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب نقطه"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        WindowState="Maximized"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <TextBlock Text="روی نقطه مورد نظر کلیک کنید  |  Esc برای لغو"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   Background="#AA000000"
                   Padding="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,40,0,0"/>
    </Grid>
</Window>
