<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Windows 7 SP1 / 8.1 / 10 / 11 -->
    <TargetFramework>net48</TargetFramework>

    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>AutoClickerV1</AssemblyName>
    <RootNamespace>AutoClickerV1</RootNamespace>

    <!-- Restore dependencies for both 32-bit and 64-bit Windows -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>

    <!-- .NET Framework 4.8 reference assemblies -->
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies"
      Version="1.0.3"
      PrivateAssets="All" />

  </ItemGroup>

</Project>
